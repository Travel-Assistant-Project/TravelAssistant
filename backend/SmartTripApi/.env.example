# Core database settings
DB_HOST=localhost
DB_NAME=travelassistant
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-local-password

# Use at least 32 bytes of unpredictable data. Do not reuse this example value.
JWT_SECRET=replace-with-at-least-32-random-bytes

# Cache
REDIS_CONNECTION=localhost:6379

# External services
GEMINI_API_KEY=replace-with-your-gemini-api-key
GOOGLE_API_KEY=replace-with-your-google-places-api-key
WEATHERAPI_KEY=replace-with-your-weatherapi-key
TICKETMASTER_API_KEY=replace-with-your-ticketmaster-api-key
EVENTBRITE_API_TOKEN=replace-with-your-eventbrite-token

# Comma-separated origins. This is required in production.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

ASPNETCORE_ENVIRONMENT=Development
